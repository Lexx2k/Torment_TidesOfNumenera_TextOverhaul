<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Unity.Cecil"><HintPath>$(CecilPath)</HintPath></Reference>
  </ItemGroup>
  <Target Name="CheckCecilPath" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(CecilPath)')" Text="Pass -p:CecilPath=path/to/Unity.Cecil.dll from a Unity Editor installation." />
  </Target>
</Project>
